{
  "expo": {
    "name": "Comercia Campo",
    "description": "Jornada, tareas y marcaciones del equipo de campo de Comercia.",
    "slug": "comercia-mobile",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/comercia-ubicacion-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "pro.comercia.mobile",
      "versionCode": 7,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#073B4C",
        "foregroundImage": "./assets/comercia-ubicacion-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Comercia usa tu ubicación para confirmar que estás cerca del local al marcar entrada o salida.",
          "locationAlwaysAndWhenInUsePermission": "Comercia puede reconocer cuando llegás a un local programado y avisarte. No guarda un recorrido continuo.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "./plugins/with-sim-phone-numbers",
      "./plugins/with-short-cmake-object-paths",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#18766A",
          "defaultChannel": "proximidad"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Comercia usa la cámara para adjuntar evidencia de tareas y presencia.",
          "photosPermission": "Comercia permite elegir una evidencia ya guardada en el teléfono.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "eas": {
        "projectId": "fc1ae3e6-12b8-4864-9d9e-fe1f9e06c994"
      }
    },
    "owner": "morteira"
  }
}
