// Esquema base de Comercia: identidad y plataforma configurable.
// Los módulos funcionales se agregan como extensiones independientes.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id        Int             @id @default(autoincrement())
  nombre    String          @unique
  dbName    String?         @map("db_name")
  empresaId Int?            @map("empresas_id")
  padre     Empresa?        @relation("EmpresaJerarquia", fields: [empresaId], references: [id])
  hijas     Empresa[]       @relation("EmpresaJerarquia")
  usuarios  Usuario[]
  roles     Rol[]
  modulos   EmpresaModulo[]
  paginas   EmpresaPagina[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("empresas")
}

model Conexion {
  id           Int          @id @default(autoincrement())
  nombre       String       @unique
  servernode   String?
  userDb       String?      @map("user_db")
  passwordDb   String?      @map("password_db")
  serviceLayer String?      @map("service_layer")
  versionTls   String?      @map("version_tls")
  ejecutables  Ejecutable[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  @@map("conexiones")
}

enum TipoEjecutable {
  PROCEDURE
  FUNCTION
  VIEW
  QUERY
}

enum MotorBd {
  POSTGRESQL
  SAP_HANA
  ORACLE
  MYSQL
  SQLSERVER
}

model Modulo {
  id        Int             @id @default(autoincrement())
  nombre    String
  ruta      String          @unique
  icono     String?
  orden     Int             @default(0)
  activo    Boolean         @default(true)
  paginas   Pagina[]
  empresas  EmpresaModulo[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")

  @@map("modulos")
}

model Pagina {
  id          Int             @id @default(autoincrement())
  moduloId    Int             @map("modulo_id")
  modulo      Modulo          @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  nombre      String
  ruta        String
  icono       String?
  orden       Int             @default(0)
  activo      Boolean         @default(true)
  ejecutables Ejecutable[]
  empresas    EmpresaPagina[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")

  @@unique([moduloId, ruta])
  @@map("paginas")
}

model Ejecutable {
  id         Int            @id @default(autoincrement())
  paginaId   Int            @map("pagina_id")
  pagina     Pagina         @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  nombre     String
  tipo       TipoEjecutable
  motor      MotorBd        @default(POSTGRESQL)
  conexionId Int?           @map("conexion_id")
  conexion   Conexion?      @relation(fields: [conexionId], references: [id])
  sentencia  String
  orden      Int            @default(0)
  activo     Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @default(now()) @updatedAt @map("updated_at")

  @@map("ejecutables")
}

model EmpresaModulo {
  id              Int      @id @default(autoincrement())
  empresaId       Int      @map("empresa_id")
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  moduloId        Int      @map("modulo_id")
  modulo          Modulo   @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  todasLasPaginas Boolean  @default(true) @map("todas_las_paginas")
  rolIds          Int[]    @default([]) @map("rol_ids")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([empresaId, moduloId])
  @@map("empresa_modulos")
}

model EmpresaPagina {
  id        Int      @id @default(autoincrement())
  empresaId Int      @map("empresa_id")
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  paginaId  Int      @map("pagina_id")
  pagina    Pagina   @relation(fields: [paginaId], references: [id], onDelete: Cascade)
  rolIds    Int[]    @default([]) @map("rol_ids")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([empresaId, paginaId])
  @@map("empresa_paginas")
}

model Rol {
  id          Int       @id @default(autoincrement())
  descripcion String
  empresaId   Int       @map("empresa_id")
  empresa     Empresa   @relation(fields: [empresaId], references: [id])
  rolId       Int?      @map("roles_id")
  padre       Rol?      @relation("RolJerarquia", fields: [rolId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)
  hijos       Rol[]     @relation("RolJerarquia")
  usuarios    Usuario[]

  @@unique([empresaId, descripcion])
  @@unique([id, empresaId])
  @@map("roles")
}

model Usuario {
  id           Int       @id @default(autoincrement())
  empresaId    Int       @map("empresa_id")
  empresa      Empresa   @relation(fields: [empresaId], references: [id])
  nombre       String
  apellido     String
  correo       String    @unique
  nombreLogin  String    @unique @map("nombre_login")
  passwordHash String    @map("password_hash")
  ruc          String    @unique
  celular      String
  rolId        Int?      @map("rol_id")
  rol          Rol?      @relation(fields: [rolId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)
  superiorId   Int?      @map("superior_id")
  superior     Usuario?  @relation("UsuarioJerarquia", fields: [superiorId], references: [id])
  subordinados Usuario[] @relation("UsuarioJerarquia")
  esSuperadmin Boolean   @default(false) @map("es_superadmin")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("usuarios")
}
